#!/bin/sh
# /etc/kernel/postinst.d/zz-amdgpu-nodither
# Runs whenever a new kernel is installed. Rebuilds + installs the
# dither-disabled amdgpu for that kernel so the fix survives kernel updates.
# Never fails the apt transaction (rebuild.sh soft-fails on its own).
KVER="$1"
[ -n "$KVER" ] || exit 0
LOG=/var/log/amdgpu-nodither.log
{
  echo "=== $(date '+%F %T') postinst.d hook for kernel $KVER ==="
  if command -v flock >/dev/null 2>&1; then
    flock -w 1800 /run/lock/amdgpu-nodither.lock \
      /usr/local/sbin/amdgpu-nodither-rebuild.sh "$KVER" || echo "rebuild.sh returned $?"
  else
    /usr/local/sbin/amdgpu-nodither-rebuild.sh "$KVER" || echo "rebuild.sh returned $?"
  fi
} >>"$LOG" 2>&1
exit 0
